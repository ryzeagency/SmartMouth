{% comment %}
  Full-width clickable promo banner with separate desktop and mobile images.
  Falls back to the launch banner files when no image is picked in the theme editor.
{% endcomment %}
{% liquid
  assign banner_link = section.settings.link | default: routes.all_products_collection_url
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image

  assign fallback_desktop_url = 'https://cdn.shopify.com/s/files/1/0888/4578/files/SMT_Site_Banner_v3.webp?v=1792183337'
  assign fallback_mobile_url = 'https://cdn.shopify.com/s/files/1/0888/4578/files/SMT_Mobile_Site_Banner_v1.webp?v=1792183337'

  assign banner_alt = desktop_image.alt | default: mobile_image.alt | default: 'Shop all SmartMouth products'
%}

<style>
  .smt-promo-banner__link,
  .smt-promo-banner__picture,
  .smt-promo-banner__image {
    display: block;
    width: 100%;
  }

  .smt-promo-banner__image {
    height: auto;
  }
</style>

<div class="smt-promo-banner">
  <a href="{{ banner_link }}" class="smt-promo-banner__link">
    <picture class="smt-promo-banner__picture">
      {% if mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1100 }} 1100w,
            {{ mobile_image | image_url: width: 1500 }} 1500w
          "
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {% elsif desktop_image == blank %}
        <source
          media="(max-width: 749px)"
          srcset="{{ fallback_mobile_url }}"
          width="750"
          height="900"
        >
      {% endif %}

      {% if desktop_image != blank %}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2560, 3840',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'smt-promo-banner__image',
            alt: banner_alt
        }}
      {% else %}
        <img
          src="{{ fallback_desktop_url }}"
          alt="{{ banner_alt | escape }}"
          width="1920"
          height="600"
          loading="eager"
          fetchpriority="high"
          class="smt-promo-banner__image"
        >
      {% endif %}
    </picture>
  </a>
</div>

{% schema %}
{
  "name": "Home Promo Banner",
  "tag": "section",
  "class": "section section-smt-home-promo-banner",
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Banner link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended: 1920 x 600px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Shown below 750px wide. Recommended: 750 x 900px"
    }
  ],
  "presets": [
    {
      "name": "Home Promo Banner"
    }
  ]
}
{% endschema %}
