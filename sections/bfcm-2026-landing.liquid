<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} [data-bf26-carousel]').forEach(function (root) {
      var track = root.querySelector('.bf26-smc__track');
      var slides = root.querySelectorAll('.bf26-smc__slide');
      var current = 0;

      function go(index) {
        current = (index + slides.length) % slides.length;
        track.style.transform = 'translateX(' + current * -100 + '%)';
        root.querySelectorAll('[data-go]').forEach(function (el) {
          el.setAttribute('aria-current', Number(el.dataset.go) === current ? 'true' : 'false');
        });
      }

      root.addEventListener('click', function (event) {
        var target = event.target.closest('[data-go], [data-step]');
        if (!target) return;
        if (target.dataset.go !== undefined) go(Number(target.dataset.go));
        if (target.dataset.step !== undefined) go(current + Number(target.dataset.step));
      });
    });
  })();
</script>

