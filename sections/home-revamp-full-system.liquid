{% liquid
  assign section_label = section.settings.heading | default: section.settings.eyebrow | strip_html
%}

<section class="home-full-system" aria-label="{{ section_label | escape }}">
  <div class="home-full-system__container">
    <header class="home-full-system__header">
      {% if section.settings.eyebrow != blank %}
        <p class="home-full-system__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        {% liquid
          assign escaped_heading = section.settings.heading | escape
          assign escaped_heading_highlight = section.settings.heading_highlight_text | strip | escape
        %}
        <h2 class="home-full-system__heading">
          {% if escaped_heading_highlight != blank %}
            {% capture highlighted_heading_text %}<span class="home-full-system__heading-highlight">{{ escaped_heading_highlight }}</span>{% endcapture %}
            {{ escaped_heading | replace: escaped_heading_highlight, highlighted_heading_text }}
          {% else %}
            {{ escaped_heading }}
          {% endif %}
        </h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="home-full-system__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="home-full-system__grid">
        {% for block in section.blocks %}
          {% liquid
            assign card_product = block.settings.product
            assign card_image = block.settings.custom_image
            if card_image == blank and card_product != blank
              assign card_image = card_product.featured_image
            endif

            assign card_title = block.settings.title
            if card_title == blank and card_product != blank
              assign card_title = card_product.title
            endif

            assign card_url = block.settings.link
            if card_url == blank and card_product != blank
              assign card_url = card_product.url
            endif
            if card_url == blank
              assign card_url = routes.all_products_collection_url
            endif

            assign card_sale_price = block.settings.price_text
            assign card_original_price = block.settings.original_price_text
            assign card_variant = blank
            assign card_is_on_sale = false

            if card_product != blank
              assign card_variant = card_product.selected_or_first_available_variant
              if card_variant != blank and card_variant.compare_at_price != blank and card_variant.compare_at_price > card_variant.price
                assign card_is_on_sale = true
              endif

              if card_sale_price == blank
                if card_is_on_sale
                  assign card_sale_price = card_variant.price | money
                else
                  assign formatted_price = card_product.price | money
                  if card_product.price_varies
                    assign card_sale_price = 'From ' | append: formatted_price
                  else
                    assign card_sale_price = formatted_price
                  endif
                endif
              endif

              if card_original_price == blank and card_is_on_sale
                assign card_original_price = card_variant.compare_at_price | money
              endif
            endif

            assign card_alt = block.settings.image_alt
            if card_alt == blank and card_image.alt != blank
              assign card_alt = card_image.alt
            endif
            if card_alt == blank
              assign card_alt = card_title
            endif
          %}

          <article class="home-full-system__card" {{ block.shopify_attributes }}>
            <a class="home-full-system__image-link" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1300, 1600',
                    sizes: '(min-width: 990px) 28vw, (min-width: 750px) 42vw, 85vw',
                    class: 'home-full-system__image',
                    loading: 'lazy',
                    alt: card_alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'home-full-system__placeholder' }}
              {% endif %}
            </a>

            <div class="home-full-system__card-content">
              {% if block.settings.category != blank %}
                <p class="home-full-system__category">{{ block.settings.category | escape }}</p>
              {% endif %}

              {% if card_title != blank %}
                <h3 class="home-full-system__card-title">
                  <a href="{{ card_url }}">{{ card_title | escape }}</a>
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="home-full-system__description rte">{{ block.settings.description }}</div>
              {% elsif card_product != blank and card_product.description != blank %}
                <p class="home-full-system__description">
                  {{ card_product.description | strip_html | truncatewords: 24 }}
                </p>
              {% endif %}

              {% if card_sale_price != blank or card_original_price != blank %}
                <p class="home-full-system__price">
                  {% if card_original_price != blank %}
                    <s class="home-full-system__price-original">{{ card_original_price | escape }}</s>
                  {% endif %}
                  {% if card_sale_price != blank %}
                    <span class="home-full-system__price-current{% if card_original_price != blank %} home-full-system__price-current--sale{% endif %}">
                      {{ card_sale_price | escape }}
                    </span>
                  {% endif %}
                </p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                {% if block.settings.add_to_cart_on_click and card_product != blank and card_variant != blank %}
                  <form
                    method="post"
                    action="{{ routes.cart_add_url }}"
                    class="home-full-system__product-form"
                    data-home-full-system-add-form
                  >
                    <input type="hidden" name="id" value="{{ card_variant.id }}">
                    <input type="hidden" name="quantity" value="1">

                    <button
                      type="submit"
                      name="add"
                      class="button button--primary home-full-system__button"
                      data-default-label="{{ block.settings.button_label | escape }}"
                      data-added-label="ADDED TO CART"
                      {% unless card_variant.available %}disabled{% endunless %}
                    >
                      {% if card_variant.available %}
                        {{ block.settings.button_label | escape }}
                      {% else %}
                        SOLD OUT
                      {% endif %}
                    </button>

                    <p
                      class="home-full-system__cart-message"
                      data-home-full-system-cart-message
                      role="status"
                      aria-live="polite"
                      hidden
                    ></p>
                  </form>
                {% else %}
                  <a class="button button--primary home-full-system__button" href="{{ card_url }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    --home-system-body-size: 1vw;
  }

  #shopify-section-{{ section.id }} .home-full-system {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-block: {{ section.settings.padding_top }}vw {{ section.settings.padding_bottom }}vw;
  }

  #shopify-section-{{ section.id }} .home-full-system__container {
    width: 80vw;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .home-full-system__header {
    max-width: 58vw;
    margin-inline: auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .home-full-system__eyebrow {
    margin: 0 0 1.25vw;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 1.45vw;
    font-style: var(--font-body-style);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .home-full-system__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-family: var(--font-heading-family);
    font-size: 2.55vw;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .home-full-system__heading-highlight {
    color: {{ section.settings.heading_highlight_color }};
  }

  #shopify-section-{{ section.id }} .home-full-system__body,
  #shopify-section-{{ section.id }} .home-full-system__description {
    color: inherit;
    font-family: var(--font-body-family);
    font-size: var(--home-system-body-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .home-full-system__body {
    margin-top: 1.15vw;
  }

  #shopify-section-{{ section.id }} .home-full-system__body > *,
  #shopify-section-{{ section.id }} .home-full-system__description > * {
    margin-block: 0;
  }

  #shopify-section-{{ section.id }} .home-full-system__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cards_per_row }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}vw;
    margin-top: 3.5vw;
  }

  #shopify-section-{{ section.id }} .home-full-system__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 0.05vw solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}vw;
    background: {{ section.settings.card_background }};
    box-shadow: 0 0.5vw 1.8vw rgba(6, 38, 74, 0.06);
  }

  #shopify-section-{{ section.id }} .home-full-system__image-link {
    display: block;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: {{ section.settings.image_background }};
  }

  #shopify-section-{{ section.id }} .home-full-system__image,
  #shopify-section-{{ section.id }} .home-full-system__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .home-full-system__image {
    box-sizing: border-box;
    transition: transform 300ms ease;
  }

  #shopify-section-{{ section.id }} .home-full-system__image-link:hover .home-full-system__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .home-full-system__placeholder {
    color: rgba(6, 38, 74, 0.18);
  }

  #shopify-section-{{ section.id }} .home-full-system__card-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 1.55vw;
  }

  #shopify-section-{{ section.id }} .home-full-system__category {
    margin: 0 0 0.5vw;
    color: {{ section.settings.accent_color }};
    font-family: var(--font-body-family);
    font-size: 0.7vw;
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .home-full-system__card-title {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 1.35vw;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .home-full-system__card-title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .home-full-system__description {
    margin: 0.8vw 0 0;
    color: {{ section.settings.description_color }};
  }

  #shopify-section-{{ section.id }} .home-full-system__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55vw;
    margin: 1.1vw 0 0;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 0.95vw;
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .home-full-system__price-original {
    color: {{ section.settings.original_price_color }};
    font-weight: 500;
    text-decoration-thickness: 0.08em;
  }

  #shopify-section-{{ section.id }} .home-full-system__price-current {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .home-full-system__price-current--sale {
    color: {{ section.settings.sale_price_color }};
  }

  #shopify-section-{{ section.id }} .home-full-system__product-form {
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .home-full-system__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    margin-top: auto;
    padding: 0.8vw 1.2vw;
    border-color: {{ section.settings.button_background }};
    border-radius: 999vw;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: 0.85vw;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .home-full-system__product-form .home-full-system__button {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .home-full-system__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .home-full-system__button.is-loading {
    cursor: wait;
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .home-full-system__cart-message {
    margin: 0.6vw 0 0;
    color: {{ section.settings.description_color }};
    font-family: var(--font-body-family);
    font-size: 0.75vw;
    line-height: 1.3;
    text-align: center;
  }

  .home-full-system__button::before, .home-full-system__button::after {
      display: none;
  }

  #shopify-section-{{ section.id }} .home-full-system__description:not(:last-child),
  #shopify-section-{{ section.id }} .home-full-system__price:not(:last-child) {
    margin-bottom: 1.3vw;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    #shopify-section-{{ section.id }} .home-full-system__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --home-system-body-size: 4vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__container {
      width: 85vw;
    }

    #shopify-section-{{ section.id }} .home-full-system {
      padding-block: 12vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__header {
      max-width: none;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .home-full-system__eyebrow {
      margin-bottom: 3vw;
      font-size: 4.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__heading {
      font-size: 6.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__body {
      margin-top: 3.5vw;
      font-size: 3.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__grid {
      grid-template-columns: 1fr;
      gap: 6vw;
      margin-top: 8vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__card {
      border-width: 0.2vw;
      border-radius: {{ section.settings.card_radius | times: 2.5 }}vw;
      box-shadow: 0 2vw 6vw rgba(6, 38, 74, 0.08);
    }

    #shopify-section-{{ section.id }} .home-full-system__image {
      padding: 0;
    }

    #shopify-section-{{ section.id }} .home-full-system__card-content {
      padding: 6vw;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .home-full-system__category {
      margin-bottom: 2vw;
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__card-title {
      font-size: 4.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__description {
      margin-top: 3vw;
      font-size: 3.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__price {
      gap: 2vw;
      margin-top: 4vw;
      font-size: 3.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__button {
      margin-top: 5vw;
      padding: 3.5vw 5vw;
      font-size: 3.5vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__product-form .home-full-system__button {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .home-full-system__cart-message {
      margin-top: 2vw;
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .home-full-system__description:not(:last-child),
    #shopify-section-{{ section.id }} .home-full-system__price:not(:last-child) {
      margin-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .home-full-system__image {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');

    if (!section || section.dataset.homeFullSystemCartReady === 'true') return;
    section.dataset.homeFullSystemCartReady = 'true';

    const getCartDrawer = () => document.querySelector('cart-drawer');

    section.querySelectorAll('[data-home-full-system-add-form]').forEach((form) => {
      const button = form.querySelector('button[type="submit"]');
      const cartDrawer = getCartDrawer();

      // Match Dawn's native product form accessibility behavior.
      if (button && cartDrawer) {
        button.setAttribute('aria-haspopup', 'dialog');
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        const message = form.querySelector('[data-home-full-system-cart-message]');
        const drawer = getCartDrawer();

        if (!submitButton || submitButton.disabled) return;

        const defaultLabel = submitButton.dataset.defaultLabel || submitButton.textContent.trim();
        const addedLabel = submitButton.dataset.addedLabel || 'ADDED TO CART';
        const formData = new FormData(form);

        // Dawn 15.4.1 expects the exact sections requested by its cart-drawer component.
        if (drawer && typeof drawer.getSectionsToRender === 'function') {
          formData.append(
            'sections',
            drawer.getSectionsToRender().map((section) => section.id).join(',')
          );
          formData.append('sections_url', window.location.pathname);

          if (typeof drawer.setActiveElement === 'function') {
            drawer.setActiveElement(document.activeElement);
          }
        }

        submitButton.disabled = true;
        submitButton.classList.add('is-loading');
        submitButton.textContent = 'ADDING...';

        if (message) {
          message.hidden = true;
          message.textContent = '';
        }

        try {
          const addUrl = window.routes?.cart_add_url || `${window.Shopify?.routes?.root || '/'}cart/add.js`;
          const response = await fetch(addUrl, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
          });

          const result = await response.json();

          // Shopify can return a JSON error payload with status 422.
          if (!response.ok || result.status) {
            throw new Error(result.description || result.message || 'Unable to add this product to the cart.');
          }

          if (drawer && typeof drawer.renderContents === 'function' && result.sections) {
            // This is Dawn's native add-to-cart behavior. renderContents() updates
            // #CartDrawer + #cart-icon-bubble and then opens the drawer.
            drawer.renderContents(result);
            drawer.classList.remove('is-empty');
          } else {
            // If the store is not actually configured to use a cart drawer,
            // send the customer to the cart instead of silently doing nothing.
            window.location.href = window.routes?.cart_url || `${window.Shopify?.routes?.root || '/'}cart`;
            return;
          }

          submitButton.textContent = addedLabel;

          if (message) {
            message.textContent = 'Added to cart.';
            message.hidden = false;
          }

          // Optional compatibility events for other theme/app listeners.
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item: result } }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { detail: { item: result } }));

          window.setTimeout(() => {
            submitButton.textContent = defaultLabel;
            submitButton.disabled = false;
            if (message) message.hidden = true;
          }, 1800);
        } catch (error) {
          submitButton.textContent = defaultLabel;
          submitButton.disabled = false;

          if (message) {
            message.textContent = error.message || 'Unable to add this product to the cart.';
            message.hidden = false;
          }

          console.error('[Home Full System] Add to cart error:', error);
        } finally {
          submitButton.classList.remove('is-loading');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Home Full System",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FULL SMARTMOUTH™ SYSTEM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mouthwash is just the beginning."
    },
    {
      "type": "text",
      "id": "heading_highlight_text",
      "label": "Heading words to highlight",
      "info": "Enter an exact word or phrase from the heading. Leave blank for no highlight."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every SmartMouth™ product is built on the same Smart-Zinc™ Technology. Extend your protection through every part of your routine — brush, rinse, go.</p>"
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards per row",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "unit": "vw",
      "label": "Card gap",
      "default": 1.5
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "3 / 4", "label": "Portrait" }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "vw",
      "label": "Card corner radius",
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "vw",
      "label": "Top spacing",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "vw",
      "label": "Bottom spacing",
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#06264A"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#06264A"
    },
    {
      "type": "color",
