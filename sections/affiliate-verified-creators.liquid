      "info": "Upload the isolated creator/product image when available."
    },
    {
      "type": "text",
      "id": "creator_image_alt",
      "label": "Creator image alt text",
      "default": "Lifestyle creator holding a SmartMouth bottle"
    },
    {
      "type": "text",
      "id": "quote_line_1",
      "label": "Quote line 1",
      "default": "“I used to worry about bad breath."
    },
    {
      "type": "text",
      "id": "quote_line_2_prefix",
      "label": "Quote line 2",
      "default": "SmartMouth gives me"
    },
    {
      "type": "text",
      "id": "quote_accent",
      "label": "Quote accent",
      "default": "24-hour confidence"
    },
    {
      "type": "text",
      "id": "quote_line_3",
      "label": "Quote line 3",
      "default": "with just two rinses a day.”"
    },
    {
      "type": "text",
      "id": "username",
      "label": "Creator username",
      "default": "@username"
    },
    {
      "type": "text",
      "id": "creator_type",
      "label": "Creator type",
      "default": "LIFESTYLE CREATOR"
    },
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VERIFIED INFLUENCERS. REAL RESULTS."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Trusted by creators"
    },
    {
      "type": "text",
      "id": "heading_line_2_prefix",
      "label": "Heading line 2",
      "default": "who"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "don’t settle."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "They put SmartMouth to the test – and made it their everyday essential for all-day confidence."
    },
    {
      "type": "header",
      "content": "Default button 1"
    },
    {
      "type": "text",
      "id": "cta_1_bold_before",
      "label": "Bold text before",
      "default": "10% OFF + FREE SHIPPING →"
    },
    {
      "type": "text",
      "id": "cta_1_regular",
      "label": "Regular text",
      "default": "USE CODE"
    },
    {
      "type": "text",
      "id": "cta_1_bold_after",
      "label": "Bold text after",
      "default": "XXX"
    },
    {
