<section
  class="hr-influencers{% if section.settings.creator_image != blank %} hr-influencers--has-custom-image{% endif %}"
  aria-labelledby="InfluencersHeading-{{ section.id }}"
>
  <div class="hr-influencers__container">
    <div class="hr-influencers__main">
      <div class="hr-influencers__testimonial">
        <article class="hr-influencers__creator-card">
          <div
            class="hr-influencers__creator-media{% if section.settings.creator_image != blank %} hr-influencers__creator-media--custom{% else %} hr-influencers__creator-media--fallback{% endif %}"
          >
            {% if section.settings.creator_image != blank %}
              {% liquid
                assign creator_alt = section.settings.creator_image.alt | default: section.settings.creator_image_alt | strip
              %}
              {{
                section.settings.creator_image
                | image_url: width: 1000
                | image_tag:
                  widths: '320, 480, 640, 800, 1000',
                  sizes: '(min-width: 750px) 18.07vw, 58vw',
                  loading: 'lazy',
                  class: 'hr-influencers__creator-image',
                  alt: creator_alt
              }}
              {% render 'image-text-equivalent', image: section.settings.creator_image, fallback: section.settings.creator_image_alt %}
            {% else %}
              <img
                class="hr-influencers__creator-fallback"
                src="{{ '3bf1079d-8584-4ad6-8743-b0772db481bd.png' | asset_url }}"
                alt="{{ section.settings.creator_image_alt | escape }}"
                width="1920"
                height="768"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="hr-influencers__creator-content">
            <blockquote class="hr-influencers__quote">
              {% if section.settings.quote_line_1 != blank %}
                <span class="hr-influencers__quote-line">
                  {{ section.settings.quote_line_1 | escape }}
                </span>
              {% endif %}

              {% if section.settings.quote_line_2_prefix != blank or section.settings.quote_accent != blank %}
                <span class="hr-influencers__quote-line">
                  {{ section.settings.quote_line_2_prefix | escape }}
                  {% if section.settings.quote_line_2_prefix != blank and section.settings.quote_accent != blank %} {% endif %}
                  {% if section.settings.quote_accent != blank %}
                    <span class="hr-influencers__quote-accent">
                      {{- section.settings.quote_accent | escape -}}
                    </span>
                  {% endif %}
                </span>
              {% endif %}

              {% if section.settings.quote_line_3 != blank %}
                <span class="hr-influencers__quote-line">
                  {{ section.settings.quote_line_3 | escape }}
                </span>
              {% endif %}
            </blockquote>

            <footer class="hr-influencers__creator-credit">
              {% if section.settings.username != blank %}
                <span class="hr-influencers__username">
                  {{ section.settings.username | escape }}
                </span>
              {% endif %}

              {% if section.settings.creator_type != blank %}
                <span class="hr-influencers__creator-type">
                  {{ section.settings.creator_type | escape }}
                </span>
              {% endif %}
            </footer>
          </div>
        </article>
      </div>

      <header class="hr-influencers__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="hr-influencers__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h2
          class="hr-influencers__heading"
          id="InfluencersHeading-{{ section.id }}"
        >
          {% if section.settings.heading_line_1 != blank %}
            <span class="hr-influencers__heading-line">
              {{ section.settings.heading_line_1 | escape }}
            </span>
          {% endif %}

          {% if section.settings.heading_line_2_prefix != blank or section.settings.heading_accent != blank %}
            <span class="hr-influencers__heading-line">
              {{ section.settings.heading_line_2_prefix | escape }}
              {% if section.settings.heading_line_2_prefix != blank and section.settings.heading_accent != blank %} {% endif %}
              {% if section.settings.heading_accent != blank %}
                <span class="hr-influencers__heading-accent">
                  {{- section.settings.heading_accent | escape -}}
                </span>
              {% endif %}
            </span>
          {% endif %}
        </h2>

        {% if section.settings.subheading != blank %}
          <p class="hr-influencers__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {% endif %}
      </header>
    </div>

    {%- comment -%}
      New section instances receive the two CTA blocks through the preset.

      Existing section instances do not automatically receive newly-added
      preset blocks in Shopify, so the two editable section-setting CTAs below
      are used as a fallback whenever no blocks exist.
    {%- endcomment -%}

    <div class="hr-influencers__actions">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div
            class="hr-influencers__action"
            style="
              --action-background: {{ block.settings.background_color }};
              --action-text: {{ block.settings.text_color }};
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a
                class="button hr-influencers__button"
                href="{{ block.settings.link }}"
              >
                {% if block.settings.strong_text_before != blank %}
                  <strong>{{ block.settings.strong_text_before | escape }}</strong>
                {% endif %}

                {% if block.settings.regular_text != blank %}
                  <span>{{ block.settings.regular_text | escape }}</span>
                {% endif %}

                {% if block.settings.strong_text_after != blank %}
                  <strong>{{ block.settings.strong_text_after | escape }}</strong>
                {% endif %}
              </a>
            {% else %}
              <span class="button hr-influencers__button">
                {% if block.settings.strong_text_before != blank %}
                  <strong>{{ block.settings.strong_text_before | escape }}</strong>
                {% endif %}

                {% if block.settings.regular_text != blank %}
                  <span>{{ block.settings.regular_text | escape }}</span>
                {% endif %}

                {% if block.settings.strong_text_after != blank %}
                  <strong>{{ block.settings.strong_text_after | escape }}</strong>
                {% endif %}
              </span>
            {% endif %}
          </div>
        {% endfor %}

      {% else %}
        <div
          class="hr-influencers__action"
          style="
            --action-background: {{ section.settings.cta_1_background }};
            --action-text: {{ section.settings.cta_1_text_color }};
          "
        >
          {% if section.settings.cta_1_link != blank %}
            <a
              class="button hr-influencers__button"
              href="{{ section.settings.cta_1_link }}"
            >
              {% if section.settings.cta_1_bold_before != blank %}
                <strong>{{ section.settings.cta_1_bold_before | escape }}</strong>
              {% endif %}

              {% if section.settings.cta_1_regular != blank %}
                <span>{{ section.settings.cta_1_regular | escape }}</span>
              {% endif %}

              {% if section.settings.cta_1_bold_after != blank %}
                <strong>{{ section.settings.cta_1_bold_after | escape }}</strong>
              {% endif %}
            </a>
          {% else %}
            <span class="button hr-influencers__button">
              {% if section.settings.cta_1_bold_before != blank %}
                <strong>{{ section.settings.cta_1_bold_before | escape }}</strong>
              {% endif %}

              {% if section.settings.cta_1_regular != blank %}
                <span>{{ section.settings.cta_1_regular | escape }}</span>
              {% endif %}

              {% if section.settings.cta_1_bold_after != blank %}
                <strong>{{ section.settings.cta_1_bold_after | escape }}</strong>
              {% endif %}
            </span>
          {% endif %}
        </div>

        <div
          class="hr-influencers__action"
          style="
            --action-background: {{ section.settings.cta_2_background }};
            --action-text: {{ section.settings.cta_2_text_color }};
          "
        >
          {% if section.settings.cta_2_link != blank %}
            <a
              class="button hr-influencers__button"
              href="{{ section.settings.cta_2_link }}"
            >
              {% if section.settings.cta_2_bold_before != blank %}
                <strong>{{ section.settings.cta_2_bold_before | escape }}</strong>
              {% endif %}

              {% if section.settings.cta_2_regular != blank %}
                <span>{{ section.settings.cta_2_regular | escape }}</span>
              {% endif %}

              {% if section.settings.cta_2_bold_after != blank %}
                <strong>{{ section.settings.cta_2_bold_after | escape }}</strong>
              {% endif %}
            </a>
          {% else %}
            <span class="button hr-influencers__button">
              {% if section.settings.cta_2_bold_before != blank %}
                <strong>{{ section.settings.cta_2_bold_before | escape }}</strong>
              {% endif %}

              {% if section.settings.cta_2_regular != blank %}
                <span>{{ section.settings.cta_2_regular | escape }}</span>
              {% endif %}

              {% if section.settings.cta_2_bold_after != blank %}
                <strong>{{ section.settings.cta_2_bold_after | escape }}</strong>
              {% endif %}
            </span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    --hr-influencers-background: {{ section.settings.background_color }};
    --hr-influencers-text: {{ section.settings.text_color }};
    --hr-influencers-card: {{ section.settings.card_background_color }};
    --hr-influencers-quote-accent: {{ section.settings.quote_accent_color }};
    --hr-influencers-heading-underline: {{ section.settings.heading_underline_color }};
    --hr-influencers-badge: {{ section.settings.badge_background_color }};
  }

  #shopify-section-{{ section.id }} .hr-influencers {
    overflow: hidden;
    padding: 10.84vw 0 4.36vw;
    color: var(--hr-influencers-text);
    background: var(--hr-influencers-background);
  }

  #shopify-section-{{ section.id }} .hr-influencers__container {
    width: 85vw;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .hr-influencers__main {
    display: grid;
    grid-template-columns: 54.8vw 27.7vw;
    column-gap: 2.5vw;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .hr-influencers__testimonial {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-card {
    position: relative;
    width: calc(100% + 2.8125vw);
    height: 17.82vw;
    margin-left: -2.8125vw;
    overflow: visible;
    border-radius: 1.45vw;
    background: var(--hr-influencers-card);
    box-shadow: 0 .15vw 1.1vw rgba(6, 32, 60, .1);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-media {
    position: absolute;
    bottom: 0;
    left: 1.367vw;
    z-index: 2;
    width: 18.07vw;
    height: 24.27vw;
    overflow: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    object-position: left bottom;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-fallback {
    position: absolute;
    top: -4.395vw;
    left: -6.055vw;
    display: block;
    width: 100vw;
    max-width: none;
    height: auto;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-content {
    position: relative;
    z-index: 3;
    height: 100%;
    padding: 3.32vw 2.2vw 0 21.48vw;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .hr-influencers__quote {
    margin: 0;
    padding: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 1.55vw;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0;
    line-height: 1.42;
    border-left: 0;
  }

  #shopify-section-{{ section.id }} .hr-influencers__quote-line {
    display: block;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hr-influencers__quote-accent {
    color: var(--hr-influencers-quote-accent);
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-credit {
    margin-top: 1.95vw;
    margin-left: -.88vw;
  }

  #shopify-section-{{ section.id }} .hr-influencers__username {
    display: flex;
    align-items: center;
    width: 9.5vw;
    min-height: 2.25vw;
    padding: 0 .9vw;
    border-radius: 999px;
    color: var(--hr-influencers-text);
    background: var(--hr-influencers-badge);
    box-sizing: border-box;
    font-family: var(--font-body-family);
    font-size: 1.08vw;
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .hr-influencers__creator-type {
    display: block;
    margin-top: .48vw;
    margin-left: .88vw;
    font-family: var(--font-body-family);
    font-size: .8vw;
    font-style: var(--font-body-style);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hr-influencers__intro {
    min-width: 0;
    padding-top: 2.55vw;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .hr-influencers__eyebrow {
    margin: 0 0 1.05vw;
    font-family: var(--font-body-family);
    font-size: 1.45vw;
    font-style: var(--font-body-style);
    font-weight: 600;
    letter-spacing: .01vw;
    line-height: 1.15;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hr-influencers__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 2.35vw;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .hr-influencers__heading-line {
    display: block;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hr-influencers__heading-accent {
    display: inline;
    background:
      linear-gradient(
        to bottom,
        transparent 0,
        transparent 58%,
        var(--hr-influencers-heading-underline) 58%,
        var(--hr-influencers-heading-underline) 87%,
        transparent 87%
      );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  #shopify-section-{{ section.id }} .hr-influencers__subheading {
    max-width: 27.7vw;
    margin: 2.25vw auto 0;
    font-family: var(--font-body-family);
    font-size: 1.15vw;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.36;
  }

  /*
    CTA row from the reference:
    585px + 498px with a 37px gap at 1920px.
  */
  #shopify-section-{{ section.id }} .hr-influencers__actions {
    display: grid;
    grid-template-columns: 30.47vw 25.94vw;
    gap: 1.93vw;
    justify-content: center;
    width: 100%;
    margin-top: 2.98vw;
  }

  #shopify-section-{{ section.id }} .hr-influencers__action {
    display: flex;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .hr-influencers__button.button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .34em;
    width: 100%;
    min-width: 0;
    height: 4.06vw;
    min-height: 0;
    margin: 0;
    padding: 0 1.9vw;
    border: 0;
    border-radius: 999px;
    color: var(--action-text);
    background: var(--action-background);
    box-shadow: none;
    box-sizing: border-box;
    font-family: var(--font-body-family);
    font-size: 1.26vw;
    font-style: var(--font-body-style);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hr-influencers__button.button::before,
  #shopify-section-{{ section.id }} .hr-influencers__button.button::after {
    display: none;
    content: none;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .hr-influencers__button strong {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} a.hr-influencers__button:hover {
    color: var(--action-text);
    background: var(--action-background);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} a.hr-influencers__button:focus-visible {
    outline: .12vw solid currentColor;
    outline-offset: .18vw;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hr-influencers {
      padding: 12vw 0;
    }

    #shopify-section-{{ section.id }} .hr-influencers--has-custom-image {
      padding-top: 28vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__container {
      width: 85vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__main {
      display: block;
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-card {
      width: 100%;
      height: auto;
      margin-left: 0;
      border-radius: 6vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-media--fallback {
      display: none;
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-media--custom {
      top: -20vw;
      bottom: auto;
      left: 50%;
      width: 58vw;
      height: 70vw;
      overflow: visible;
      transform: translateX(-50%);
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-content {
      height: auto;
      padding: 8vw 7vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers--has-custom-image .hr-influencers__creator-content {
      padding-top: 55vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__quote {
      font-size: 5.3vw;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .hr-influencers__quote-line {
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-credit {
      margin-top: 6vw;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .hr-influencers__username {
      width: auto;
      min-width: 38vw;
      min-height: 11vw;
      padding: 0 5vw;
      font-size: 4.6vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__creator-type {
      margin-top: 2.5vw;
      margin-left: 5vw;
      font-size: 3.3vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__intro {
      padding-top: 12vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__eyebrow {
      margin-bottom: 4vw;
      font-size: 3.9vw;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .hr-influencers__heading {
      font-size: 7vw;
    }

    #shopify-section-{{ section.id }} .hr-influencers__heading-line {
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .hr-influencers__subheading {
      max-width: 78vw;
      margin-top: 6vw;
      font-size: 4.2vw;
      line-height: 1.4;
    }

    #shopify-section-{{ section.id }} .hr-influencers__actions {
      grid-template-columns: 1fr;
      gap: 4vw;
      width: 85vw;
      margin: 10vw auto 0;
    }

    #shopify-section-{{ section.id }} .hr-influencers__button.button {
      min-height: 14vw;
      height: auto;
      padding: 3vw 5vw;
      font-size: 4vw;
      line-height: 1.15;
      white-space: normal;
    }
  }
</style>

{% schema %}
{
  "name": "Verified Influencers",
  "tag": "section",
  "class": "section section-home-revamp-influencers",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Creator testimonial"
    },
    {
