{%- comment -%}
  Destini locator section

  Renders the Destini store locator preloaded to a single UPC, and only on the
  products chosen in the theme editor. On every other product the section
  outputs nothing.

  The locator embed reads PROD and MM from the page query string, so the
  parameters are written to the URL before the Destini script is injected.

  Type scale and mobile behaviour follow the Product Smart-Zinc section.
{%- endcomment -%}

{%- liquid
  assign destini_upc = ''
  assign matched = false

  if product != blank
    if section.settings.product_1 != blank and section.settings.product_1.id == product.id
      assign destini_upc = section.settings.upc_1 | strip
      assign matched = true
    elsif section.settings.product_2 != blank and section.settings.product_2.id == product.id
      assign destini_upc = section.settings.upc_2 | strip
      assign matched = true
    endif
  endif
-%}

{%- if matched and destini_upc != blank -%}
<section
  class="destini-locator"
  aria-labelledby="DestiniLocatorHeading-{{ section.id }}"
>
  <div class="destini-locator__inner">
    <header class="destini-locator__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="destini-locator__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="destini-locator__heading" id="DestiniLocatorHeading-{{ section.id }}">
        {{ section.settings.heading | escape }}{% if section.settings.heading_highlight != blank %}
          <em>{{ section.settings.heading_highlight | escape }}</em>
        {% endif %}
      </h2>

      {%- if section.settings.subheading != blank -%}
        <div class="destini-locator__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </header>

    <div class="destini-locator__embed">
      <div
        id="destini-locator-{{ section.settings.locator_id }}"
        class="destini-locator-class"
        data-locator-id="{{ section.settings.locator_id }}"
        data-alpha-code="{{ section.settings.alpha_code }}"
      ></div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    --destini-body-size: 1vw;
    --destini-body-size-mobile: 3.5vw;
    --destini-background: {{ section.settings.background_color }};
    --destini-text: {{ section.settings.text_color }};
    --destini-highlight: {{ section.settings.highlight_color }};
  }

  #shopify-section-{{ section.id }} .destini-locator {
    padding: 3.8vw 0 5.5vw;
    color: var(--destini-text);
    background-color: var(--destini-background);
  }

  #shopify-section-{{ section.id }} .destini-locator__inner {
    width: 85vw;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .destini-locator__header {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .destini-locator__eyebrow {
    margin: 0 0 0.7vw;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 1.45vw;
    font-style: var(--font-body-style);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .destini-locator__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: 2.55vw;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .destini-locator__heading em {
    color: var(--destini-highlight);
    font-style: inherit;
  }

  #shopify-section-{{ section.id }} .destini-locator__subheading {
    max-width: 70vw;
    margin: 1.25vw auto 0;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 1.1vw;
    font-style: italic;
    font-weight: 700;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .destini-locator__subheading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .destini-locator__embed {
    width: {{ section.settings.embed_width }}vw;
    margin: 3vw auto 0;
  }

  {%- comment -%}
    Destini renders into a shadow root, so the container still matches :empty
    and gets hidden by the theme's base.css reset. One ID plus one class
    outranks that rule.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .destini-locator-class,
  #shopify-section-{{ section.id }} .destini-locator-class:empty {
    display: block;
    width: 100%;
    min-height: {{ section.settings.min_height }}vw;
  }

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .destini-locator {
      padding: {{ section.settings.mobile_padding_top }}vw 0 {{ section.settings.mobile_padding_bottom }}vw;
    }

    #shopify-section-{{ section.id }} .destini-locator__header {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .destini-locator__eyebrow {
      margin-bottom: 3vw;
      font-size: 4vw;
    }

    #shopify-section-{{ section.id }} .destini-locator__heading {
      font-size: 6.5vw;
    }

    #shopify-section-{{ section.id }} .destini-locator__subheading {
      max-width: none;
      margin-top: 5vw;
      font-size: var(--destini-body-size-mobile);
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .destini-locator__embed {
      width: 85vw;
      margin-top: 10vw;
    }

    #shopify-section-{{ section.id }} .destini-locator-class,
    #shopify-section-{{ section.id }} .destini-locator-class:empty {
      min-height: {{ section.settings.mobile_min_height }}vw;
    }
  }
</style>

<script>
  (function () {
    var upc = {{ destini_upc | json }};
    var src = 'https://lets.shop/productFirstSnippet.js';

    function setParams() {
      var params = new URLSearchParams(window.location.search);

      if (!upc) return;
      if (params.get('PROD') === upc) return;

      params.set('PROD', upc);
      params.set('MM', 'panel2');

      window.history.replaceState(
        window.history.state,
        '',
        window.location.pathname + '?' + params.toString() + window.location.hash
      );
    }

    function loadScript() {
      if (document.querySelector('script[src="' + src + '"]')) return;

      var script = document.createElement('script');
      script.src = src;
      script.charset = 'utf-8';
      script.async = false;
      document.body.appendChild(script);
    }

    setParams();
    loadScript();

    {%- if request.design_mode -%}
      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail.sectionId !== {{ section.id | json }}) return;
        setParams();
        window.location.reload();
      });
    {%- endif -%}
  })();
</script>

{%- elsif request.design_mode -%}
  <div style="width: 85vw; margin: 1vw auto; padding: 1vw 1.5vw; border: 1px dashed #b0813a; border-radius: .5vw; background: #fff8ec; color: #7a5200; font-family: var(--font-body-family, sans-serif); font-size: 14px; line-height: 1.5;">
    {%- if matched -%}
      <strong>"Store locator" is missing a UPC for this product</strong><br>
      Add the UPC in the section settings to show the locator. This notice is only visible in the theme editor.
    {%- else -%}
      <strong>"Store locator" is hidden on this product</strong><br>
      It only shows on the two products chosen in the section settings, and each one needs a UPC. This notice is only visible in the theme editor.
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Store locator",
  "tag": "section",
  "class": "section section-destini-locator",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "paragraph",
      "content": "The locator shows only on the products chosen below. Enter each UPC exactly as it appears in the Destini CMS, including any leading zeros."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "First product"
    },
    {
      "type": "text",
      "id": "upc_1",
      "label": "First product UPC",
      "info": "Digits only, no spaces."
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Second product"
    },
    {
      "type": "text",
      "id": "upc_2",
      "label": "Second product UPC",
      "info": "Digits only, no spaces."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHERE TO BUY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find this in a store"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted heading text",
      "default": "near you."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Enter your ZIP code to see which nearby stores carry this product.</p>"
    },
    {
      "type": "header",
      "content": "Locator size"
    },
    {
      "type": "range",
      "id": "embed_width",
      "min": 40,
      "max": 85,
      "step": 1,
      "unit": "vw",
      "label": "Desktop width",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "vw",
      "label": "Desktop minimum height",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "min": 40,
      "max": 180,
      "step": 5,
      "unit": "vw",
      "label": "Mobile minimum height",
      "default": 110
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "vw",
      "label": "Top spacing",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "vw",
      "label": "Bottom spacing",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#092847"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlighted heading",
      "default": "#80D3C9"
    },
    {
      "type": "header",
      "content": "Destini account"
    },
    {
      "type": "text",
      "id": "locator_id",
      "label": "Locator ID",
      "default": "4178"
    },
    {
      "type": "text",
      "id": "alpha_code",
      "label": "Alpha code",
      "default": "1052"
    }
  ],
  "presets": [
    {
      "name": "Store locator",
      "category": "Product Revamp"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
