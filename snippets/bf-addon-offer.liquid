{%- comment -%}
  Black Friday $10 add-on offer.

  When the cart has at least `bf_min_rinses` one-time-purchase items from the
  `bf_collection_handle` collection, the customer is offered the add-on product
  for $10:
  - a popup, once per browser session, right after the cart changes
    (assets/bf-addon-offer.js), and
  - a card with an "Add" button in the cart drawer, for as long as they qualify
    and the add-on is not in the cart.

  The price drop itself comes from the automatic "Black Friday Promotion"
  discount in Shopify admin (buy 2 from Rinses, get the add-on $10.97 off).
  This snippet only shows the offer. Keep the dates and quantities below in
  step with that discount.

  Rendered twice from snippets/cart-drawer.liquid:
  - part: 'setup'  -> config, popup markup and script (outside the drawer)
  - part: 'drawer' -> the offer card in the drawer footer

  Set bf_enabled to false to turn everything off.
{%- endcomment -%}

{%- liquid
  assign bf_enabled = true
  assign bf_collection_handle = 'rinses'
  assign bf_min_rinses = 2
  assign bf_addon_handle = 'black-friday-sale-add-on'
  # Price the customer pays after the automatic discount, in cents.
  assign bf_offer_price = 1000
  # The offer shows from bf_starts_at until just before bf_ends_at (US Eastern).
  assign bf_starts_at = '2026-11-16T00:00:00-05:00'
  assign bf_ends_at = '2026-12-01T00:00:00-05:00'

  assign bf_eyebrow = 'Black Friday deal unlocked'
  assign bf_heading = 'Add the extras for $10'
  assign bf_body = 'Anti-Cavity + Zinc Toothpaste, Dry Mouth Mints and a travel pack.'

  assign bf_product = all_products[bf_addon_handle]
  assign bf_variant = bf_product.selected_or_first_available_variant
  assign bf_collection = collections[bf_collection_handle]

  assign bf_ready = false
  if bf_enabled and bf_variant and bf_variant.available and bf_collection
    assign bf_ready = true
  endif

  assign bf_now = 'now' | date: '%s' | plus: 0
  assign bf_start = bf_starts_at | date: '%s' | plus: 0
  assign bf_end = bf_ends_at | date: '%s' | plus: 0
  assign bf_live = false
  if bf_ready and bf_now >= bf_start and bf_now < bf_end
    assign bf_live = true
  endif

  assign bf_offer_label = bf_offer_price | money_without_trailing_zeros
-%}

{%- if part == 'setup' and bf_ready -%}
  <style>
    .bf-addon-modal {
      position: fixed;
      inset: 0;
      z-index: 1100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .bf-addon-modal[hidden] {
      display: none;
    }

    /* display:block beats the theme's div:empty { display: none }. */
    .bf-addon-modal__overlay {
      display: block;
      position: absolute;
      inset: 0;
      background: rgba(6, 35, 66, .55);
    }

    .bf-addon-modal__panel {
      position: relative;
      width: 100%;
      max-width: 400px;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      padding: 32px 24px 20px;
      border-radius: 16px;
      text-align: center;
      color: #062342;
      background: #FFFFFF;
      box-shadow: 0 20px 60px rgba(6, 35, 66, .3);
    }

    .bf-addon-modal__close {
      position: absolute;
      top: 8px;
      right: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      color: inherit;
      background: none;
      cursor: pointer;
    }

    .bf-addon-modal__close .svg-wrapper {
      width: 16px;
      height: 16px;
    }

    .bf-addon-modal__eyebrow {
      margin: 0 0 12px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #008244;
    }

    .bf-addon-modal__image {
      display: block;
      width: 100%;
      max-width: 240px;
      height: auto;
      margin: 0 auto 16px;
      border-radius: 12px;
    }

    .bf-addon-modal__heading {
      margin: 0 0 8px;
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: 0;
      color: inherit;
    }

    .bf-addon-modal__body {
      margin: 0 0 12px;
      font-size: 15px;
      line-height: 1.45;
    }

    .bf-addon__price {
      margin: 0 0 20px;
      font-size: 18px;
    }

    .bf-addon__price s {
      margin-right: 6px;
      opacity: .6;
    }

    .bf-addon__price strong {
      color: #008244;
    }

    .bf-addon-modal .button {
      width: 100%;
    }

    .bf-addon-modal__decline {
      margin-top: 8px;
      padding: 12px;
      border: 0;
      font: inherit;
      font-size: 14px;
      text-decoration: underline;
      color: inherit;
      background: none;
      cursor: pointer;
    }

    .bf-addon__error {
      margin: 8px 0 0;
      font-size: 13px;
      color: #B3261E;
    }

    .bf-addon__error[hidden] {
      display: none;
    }

    /* Cart drawer card */
    .cart-drawer__bf-addon {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 4px 12px;
      align-items: center;
      margin-bottom: 16px;
      padding: 12px;
      border: 1.5px solid #008244;
      border-radius: 12px;
      color: #062342;
      background: #F1FAF5;
    }

    .cart-drawer__bf-addon img {
      grid-row: span 2;
      width: 64px;
      height: 64px;
      border-radius: 8px;
      object-fit: cover;
    }

    .cart-drawer__bf-addon-text {
      margin: 0;
      font-size: 14px;
      line-height: 1.35;
    }

    .cart-drawer__bf-addon-text strong {
      display: block;
    }

    .cart-drawer__bf-addon-text s {
      opacity: .6;
    }

    .cart-drawer__bf-addon .button {
      justify-self: start;
      min-height: 36px;
      min-width: 0;
      padding: 0 16px;
      font-size: 14px;
    }

    .cart-drawer__bf-addon .bf-addon__error {
      grid-column: 1 / -1;
    }

    .cart-drawer__bf-addon-note {
      margin: 0 0 16px;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 14px;
      line-height: 1.35;
      color: #062342;
      background: #FFF4E5;
    }
  </style>

  <script>
    window.bfAddonOffer = {
      variantId: {{ bf_variant.id | json }},
      productId: {{ bf_product.id | json }},
      rinseProductIds: {{ bf_collection.products | map: 'id' | json }},
      minRinses: {{ bf_min_rinses | json }},
      startsAt: {{ bf_start | times: 1000 | json }},
      endsAt: {{ bf_end | times: 1000 | json }},
    };
  </script>

  <div class="bf-addon-modal" id="BfAddonModal" hidden>
    <div class="bf-addon-modal__overlay" data-bf-addon-close></div>
    <div class="bf-addon-modal__panel" role="dialog" aria-modal="true" aria-labelledby="BfAddonModal-Heading" tabindex="-1">
      <button type="button" class="bf-addon-modal__close" data-bf-addon-close aria-label="{{ 'accessibility.close' | t }}">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
      <p class="bf-addon-modal__eyebrow">{{ bf_eyebrow }}</p>
      {%- if bf_product.featured_image -%}
        {{
          bf_product.featured_image
          | image_url: width: 480
          | image_tag: class: 'bf-addon-modal__image', alt: bf_product.featured_image.alt, loading: 'lazy', width: 240
        }}
      {%- endif -%}
      <h2 class="bf-addon-modal__heading" id="BfAddonModal-Heading">{{ bf_heading }}</h2>
      <p class="bf-addon-modal__body">{{ bf_body }}</p>
      <p class="bf-addon__price">
        <s><span class="visually-hidden">Regular price </span>{{ bf_variant.price | money }}</s>
        <strong><span class="visually-hidden">Black Friday price </span>{{ bf_offer_label }}</strong>
      </p>
      <button type="button" class="button" data-bf-addon-add>Add to cart for {{ bf_offer_label }}</button>
      <button type="button" class="bf-addon-modal__decline" data-bf-addon-close>No thanks</button>
      <p class="bf-addon__error" role="alert" hidden></p>
    </div>
  </div>

  <script src="{{ 'bf-addon-offer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if part == 'drawer' and bf_live and cart != empty -%}
  {%- liquid
    assign bf_rinse_qty = 0
    assign bf_addon_qty = 0
    for item in cart.items
      if item.product_id == bf_product.id
        assign bf_addon_qty = bf_addon_qty | plus: item.quantity
        continue
      endif
      # The discount only counts one-time purchases, so subscriptions don't qualify.
      if item.selling_plan_allocation
        continue
      endif
      for item_collection in item.product.collections
        if item_collection.id == bf_collection.id
          assign bf_rinse_qty = bf_rinse_qty | plus: item.quantity
          break
        endif
      endfor
    endfor
    assign bf_rinses_needed = bf_min_rinses | minus: bf_rinse_qty
  -%}

  {%- if bf_addon_qty == 0 and bf_rinse_qty >= bf_min_rinses -%}
    <div class="cart-drawer__bf-addon">
      {%- if bf_product.featured_image -%}
        {{
          bf_product.featured_image
          | image_url: width: 128
          | image_tag: alt: '', loading: 'lazy', width: 64, height: 64
        }}
      {%- endif -%}
      <p class="cart-drawer__bf-addon-text">
        <strong>{{ bf_heading }}</strong>
        <s><span class="visually-hidden">Regular price </span>{{ bf_variant.price | money }}</s>
        {{ bf_body }}
      </p>
      <button type="button" class="button" data-bf-addon-add>Add for {{ bf_offer_label }}</button>
      <p class="bf-addon__error" role="alert" hidden></p>
    </div>
  {%- elsif bf_addon_qty > 0 and bf_rinses_needed > 0 -%}
    <p class="cart-drawer__bf-addon-note" role="status">
      Add {{ bf_rinses_needed }} more
      {% if bf_rinses_needed == 1 %}rinse{% else %}rinses{% endif %}
      to get your extras for {{ bf_offer_label }}.
    </p>
  {%- endif -%}
{%- endif -%}
